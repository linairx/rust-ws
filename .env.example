# WebSocket Proxy Server Configuration

# UUID for VLESS protocol (default: 7bd180e8-1142-4387-93f5-03e8d750a896)
UUID=7bd180e8-1142-4387-93f5-03e8d750a896

# Server port (default: 3000)
PORT=3000

# Domain for subscription links (optional, will auto-detect if not set)
DOMAIN=

# Subscription path (default: sub)
SUB_PATH=sub

# Server name for subscription (optional)
NAME=rust-ws

# WebSocket path (default: first 8 chars of UUID)
WS_PATH=7bd180e8

# Auto access keep-alive (default: false)
AUTO_ACCESS=false

# Debug mode (default: false)
DEBUG=false
